APP_NAME=CloudVault
DATABASE_URL=sqlite:///./data/cloudvault.db
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/blobs
FRONTEND_ORIGIN=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=25
SESSION_HOURS=24
COOKIE_SECURE=false
# Future Azure adapter only; never place these in frontend variables.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=cloudvault
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=<URL-encoded ODBC connection string>
